# Базові налаштування БД
DB_USER=postgres
DB_PASSWORD=secret
DB_NAME=github_notifier
DB_HOST=db
DB_PORT=5432

# Порт, на якому буде слухати застосунок
APP_PORT=8080

# GitHub API Token (Опціонально, але рекомендовано для збільшення rate limit)
GITHUB_TOKEN=your_personal_access_token_here

# Налаштування SMTP (Опціонально, якщо пусто — використовується LogNotifier)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@yourdomain.com
